<?xml version="1.0" encoding="utf-8"?>
<!-- Source manifest. build_apk.py encodes it into Android's binary XML format. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.proresmat.healthconnect"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="PRORESMAT"
        android:icon="@drawable/icon"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">

        <activity
            android:name="com.proresmat.healthconnect.MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
